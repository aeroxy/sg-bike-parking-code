# Copy to .env and fill in. .env is gitignored.
# On Vercel, the first three go in the project's environment variables.

# MongoDB Atlas connection string for a user that can read and write only
# this app's database, which the path names. Quoted: it holds `&`.
MONGO_DB="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sg_bike_qr?retryWrites=true&w=majority&appName=sg-bike-qr"

# Login with Aero: the client id and k4.local key that https://aero.oops.wtf/connect
# gives when the app is registered with the callback
# https://sg-bike-qr.vercel.app/auth/aero. The key is shown once.
AERO_CLIENT_ID=
AERO_LOGIN_KEY=k4.local....

# Aero personal access token, used by aero-app/deploy.sh to publish the page
# that sends the old Aero address here. Mint one at https://aero.oops.wtf/connect
AERO_TOKEN=aero_...

# Optional overrides for aero-app/deploy.sh.
# AERO_PAGE=sg-bike-qr
# AERO_MCP_URL=https://aero.oops.wtf/mcp
